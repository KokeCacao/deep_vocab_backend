[Unit]
Description=DeepVocab Backend Server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/home/ubuntu/dev/deep_vocab_backend
ExecStart=/home/ubuntu/dev/deep_vocab_backend/.venv/bin/gunicorn --workers 1 --threads 8 --log-level debug --worker-class gthread --bind unix:/home/ubuntu/dev/deep_vocab_backend/deepvocab.sock --no-control-socket wsgi:app

[Install]
WantedBy=multi-user.target
